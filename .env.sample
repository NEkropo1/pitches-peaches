# Copy to .env in your run directory and fill in. .env is gitignored.
#
#   cp .env.sample runs/acme/.env
#
# Every setting below is commented out. Uncomment the ones you want by deleting
# the leading "# " — no line here carries a trailing comment, so an uncommented
# line is always the value and nothing else.
#
# Precedence: CLI flag > environment variable > peaches.toml > built-in default.
# Keys must never go in peaches.toml.


# ============ required: any ONE of these ============
# The provider is picked automatically from whichever key you set.
# Paste the whole key, with nothing before or after it.

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY also works in place of GEMINI_API_KEY.


# ============ optional: provider and model ============

# auto (the default) uses whichever key above you set. Only pin one of
# anthropic|openai|gemini if you have several keys.
# PEACHES_PROVIDER=auto

# auto = that provider's own default:
#   anthropic -> claude-opus-5
#   openai    -> gpt-5.4-mini
#   gemini    -> gemini-3-pro
# PEACHES_MODEL=auto


# ============ optional: spend ============

# low|medium|high|xhigh|max. Gemini stops at high; xhigh and max step down.
# PEACHES_EFFORT=high

# Effort for the parsing stages, which need less.
# PEACHES_PARSE_EFFORT=medium

# PEACHES_MAX_TECHNOLOGIES=3
# PEACHES_MAX_QUESTIONS_PER_TECH=3


# ============ optional: audio ============

# PEACHES_AUDIO=false

# auto|kokoro|say|none
# PEACHES_TTS_BACKEND=auto

# kokoro voice id, or a macOS `say` voice name.
# PEACHES_VOICE=af_heart

# Words per minute. ~150 slow, ~180 brisk.
# PEACHES_RATE=178


# ============ optional: end-to-end tests ============
# Skipped unless you opt in. These make real API calls and cost real money.
#
#   pytest --e2e -k smoke              # the cheap one
#   pytest --e2e                       # the full pipeline
#   pytest --e2e --provider openai     # against a specific provider

# PEACHES_E2E=1
# PEACHES_E2E_CV=/absolute/path/to/your/cv.pdf
