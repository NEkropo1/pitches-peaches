# Copy to .env in your run directory and fill in. .env is gitignored.
#
#   cp .env.sample runs/acme/.env
#
# ANTHROPIC_API_KEY is the only value that is genuinely required, and the only
# one that must never go in peaches.toml. Everything below it is optional —
# every knob also lives in peaches.toml with a default, and the precedence is
# CLI flag > environment variable > peaches.toml > built-in default.

# --- required -----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-

# --- optional: model and spend -----------------------------------------
# PEACHES_MODEL=claude-opus-5
# PEACHES_EFFORT=high                 # low|medium|high|xhigh|max
# PEACHES_PARSE_EFFORT=medium         # effort for the parsing stages

# --- optional: playbook size -------------------------------------------
# PEACHES_MAX_TECHNOLOGIES=3
# PEACHES_MAX_QUESTIONS_PER_TECH=3

# --- optional: audio ----------------------------------------------------
# PEACHES_AUDIO=false
# PEACHES_TTS_BACKEND=auto            # auto|kokoro|say|none
# PEACHES_VOICE=af_heart              # kokoro voice id, or a macOS `say` voice
# PEACHES_RATE=178                    # words per minute

# --- optional: end-to-end tests ----------------------------------------
# The e2e suite is skipped unless you opt in. It makes real API calls and
# costs real money — roughly $2-5 for the full-pipeline test.
#
#   pytest --e2e                      # run them
#   pytest --e2e -k smoke             # just the cheap one (~$0.05)
#
# PEACHES_E2E=1                       # equivalent to passing --e2e
# PEACHES_E2E_CV=/absolute/path/to/your/cv.pdf   # use your real CV instead of the fixture
